# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the scraper, Stripe webhook and digest. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (Developers → API keys; use test keys until launch) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create a product "Permit Watch Sarasota" with a $99/month recurring price and paste its ID
STRIPE_PRICE_ID=price_...

# --- Morning digest email (resend.com) ---
RESEND_API_KEY=re_...
DIGEST_FROM_EMAIL=Permit Watch <digest@yourdomain.com>

# Shared secret the morning-digest GitHub Action sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=make-a-long-random-string
